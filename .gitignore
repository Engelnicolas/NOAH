#################################################################
# NOAH .gitignore (refactored)
#  - Consolidated duplicates
#  - Added canonical secrets protection
#  - Preserved encrypted/packaged artifacts ignore patterns
#################################################################

############################
# Python / Build Artifacts #
############################
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
pip-wheel-metadata/
*.manifest
*.spec
*.log
*.sqlite3
*.db

############################
# Virtual Environments     #
############################
.venv/
env/
venv/
ENV/

############################
# Environment Files        #
############################
.env
.env.*
.envrc

############################
# Configuration (unencrypted)
############################
config.yaml
config.yml
secrets.yaml
secrets.yml
# Allow encrypted variants (except machine-specific config tied to local age key)
!*.enc.yaml
!*.enc.yml
Config/config.enc.yaml
Secrets/canonical-secrets.enc.yaml

############################
# Canonical Secrets & Keys #
############################
Age/
*.agekey
.sops.yaml

############################
# Ansible / Deployment     #
############################
*.retry
*.log
.secret*
vault_pass.txt
Helm/*/secrets/

############################
# Helm                     #
############################
charts/*.tgz
helmfile.lock
tmpcharts/
.chartcache/
*.release.yaml
.values.local.yaml
.values.override.yaml
*/.temp-*

############################
# Decrypted / Temp Secrets #
############################
*.dec.yaml
*.dec.json
*.dec.env
Helm/samba4/secrets/*.yaml
Helm/samba4/secrets/*.json
Helm/samba4/secrets/*.env
Helm/samba4/secrets/samba4-secrets.temp.yaml
Helm/samba4/secrets/.temp-values.yaml
Scripts/Secrets/canonical-secrets.yaml
Scripts/Secrets/*.dec.yaml
Scripts/Secrets/*.dec.json
Scripts/Secrets/*.dec.env
Scripts/Secrets/.temp-*
Scripts/Secrets/temp-*
Scripts/Secrets/secret-*.yaml
Scripts/Secrets/secret-*.json
Scripts/Secrets/secret-*.env
Scripts/Secrets/*.log
Scripts/Certificates/ca.srl
Scripts/Certificates/ca.key
Scripts/Certificates/ca.pem
Scripts/Certificates/ca.crt
Scripts/Certificates/*.crt
Scripts/Certificates/*.key
Scripts/Certificates/*.pem
Scripts/Certificates/*.srl
Scripts/Secrets/canonical-secrets.enc.yaml

############################
# Legacy Encrypted Files (deprecated)
############################
Helm/authentik/secrets/authentik-secret.enc.yaml
Helm/authentik/secrets/authentik-secrets.enc.yaml
Helm/cilium/secrets/cilium-secrets.enc.yaml
Helm/samba4/secrets/samba4-secrets.enc.yaml

############################
# Certificates (private)   #
############################
Certificates/ca.srl
Certificates/ca.key
Certificates/ca.pem
Certificates/ca.crt
*.crt
*.key
*.pem

############################
# OS / Editor / Misc       #
############################
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.bak
*.tmp
.claude/
.claude/CLAUDE.md
.claude/*

#################################################################
# END
#################################################################

docs/DEPLOYMENT_GUIDE.md
Config/noah_cfg_tmp_*.enc.yaml
